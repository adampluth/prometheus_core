# Prometheus Platform - Environment Variables
# Copy this file to .env and fill in the values. 
# You can use the following command to quickly generate keys
# python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Required ---

# Provider credential used by the bundled LiteLLM proxy and the Anthropic
# direct profile
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for inter-agent A2A authentication
AGENT_SECRET=change-me-to-a-random-string

# Valkey password (Redis-compatible protocol)
REDIS_PASSWORD=change-me-to-a-random-password

# Redis-compatible Valkey connection URL (used by agents and frontend)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
# Lifetime (seconds) of each conversation's artifact catalog. 0 = never expire, so
# reopened conversations keep their artifacts (conversations themselves never expire).
# Keys written before this was 0 keep their old TTL until cleared with PERSIST.
ARTIFACT_REGISTRY_TTL_SECONDS=0

# Chainlit session encryption secret
CHAINLIT_AUTH_SECRET=change-me-to-a-random-string

# Litellm
LITELLM_MASTER_KEY=change-me-to-a-random-string
LITELLM_DB_PASSWORD=change-me-to-a-random-string

# --- Admin plane (local users, OIDC provider config, RS256 signing keys) ---
# Separate Postgres from litellm-db -- different lifecycle/ownership.
ADMIN_DB_PASSWORD=change-me-to-a-random-string
# Override only if the backend needs to reach a Postgres instance other than
# the bundled admin-db container (e.g. a managed cloud Postgres).
#ADMIN_DATABASE_URL=postgresql+asyncpg://admin:${ADMIN_DB_PASSWORD}@admin-db:5432/admin
# Encrypts OIDC client secrets and RS256 private keys at rest in admin-db.
# Only local-password login works without this set -- generating a signing
# key or configuring an OIDC provider in the admin UI needs it.
# Left blank here on purpose: `make up`/`make restart` (and their ng-/-fg
# variants) generate one into this file automatically if it's still empty --
# see the `ensure-admin-encryption-key` Makefile target. Only needed by hand
# if you're not using `make` (e.g. `docker compose up` directly):
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_DB_ENCRYPTION_KEY=

# Base URL for the OIDC redirect_uri the backend sends to identity providers.
# Required once you configure any OIDC provider (Admin > Identity Providers) --
# left blank, the backend falls back to introspecting the request it received,
# which is wrong the moment anything proxies /api requests to it (the Vite dev
# server, nginx in prod): it would see its own internal host:port, not what
# the browser is actually on, and identity providers would reject the login
# with a redirect_uri mismatch.
#
# Set this to whatever origin the browser uses to reach the platform:
#   dev (Vite dev server, default port):   http://localhost:5150
#   prod (nginx, default port):            http://localhost:8080
#   real deployment:                       https://prometheus.example.com
#
# Must exactly match the redirect URI registered with every OIDC provider:
# <this value>/api/auth/callback/<provider_id>
BACKEND_PUBLIC_URL=

# --- Optional ---

# Prometheus API base image hash used by agent builds. Keep in sync with the
# Makefile default unless you are intentionally testing a different base image.
#PROMETHEUS_API_BASE_IMAGE_HASH=

# Include the nested debug agents under agents/debug-agents/* in the generated
# docker-compose.agents.yml. Set to "true" to include them. Default: false.
DEBUG_AGENTS=false

# LLM configuration used by the agents in this Compose deployment. Independently
# deployed agents can set these variables and provider keys in their own environment.
# LLM_CONFIG_FILE overrides LLM_CONFIG_PROFILE and must exist inside the container.
LLM_CONFIG_PROFILE=registry
LLM_CONFIG_FILE=

# Direct-provider credentials. Only the keys referenced by the selected profile
# are required. The Anthropic profile uses EMBEDDING_API_KEY for embeddings.
EMBEDDING_API_KEY=
OPENAI_API_KEY=
INL_HPC_API_KEY=
INL_LITELLM_API_KEY=
AMSC_I2_API_KEY=

# Max upload size in bytes for frontend and client-agent staging (default: 100 MiB)
PROMETHEUS_MAX_UPLOAD_BYTES=104857600

# Whether agent secret is required for specialist agents (default: true)
# AGENT_SECRET_REQUIRED=true

# Corporate proxy settings (if behind a proxy)
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1,litellm,litellm-db,redis,client-agent

# DeepLynx storage credentials (required for artifact-debug-agent and deeplynx:// URI resolution)
# See prometheus_api/docs/ENV_SETUP.md for details.
# DEEPLYNX_BASE_URL=https://deeplynx.inl.gov/api/v1
# DEEPLYNX_KEY=your-api-key
# DEEPLYNX_SECRET=your-api-secret
# DEEPLYNX_ORG_ID=1
# DEEPLYNX_PROJECT_ID=1

LITELLM_LOCAL_PORT=9977
REDIS_LOCAL_PORT=6379
# FRONTEND_URL=

CLIENT_AGENT_URL=http://client-agent:8000
CLIENT_AGENT_PORT=8001
# Set true only when host-driven system tests need direct client-agent access.
PROMETHEUS_SYSTEM_TESTING=false
# React frontend host ports (docker-compose dev/prod profiles)
FRONTEND_DEV_PORT=5150
FRONTEND_PROD_PORT=8080

# Standalone FastAPI backend (backend/) — replaces Chainlit's server role
BACKEND_PORT=8600
# Session-cookie signing secret. If left blank, the backend falls back to
# CHAINLIT_AUTH_SECRET (set above); one of the two MUST be non-empty or the backend
# refuses to start. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_JWT_SECRET=

# --- Multi-user identity plane (RS256 only) ---
# Distinct from BACKEND_JWT_SECRET above: this is the short-lived JWT the
# backend mints per turn to prove the caller's identity to agents (not the
# browser session cookie). Signing is RS256 only -- there is no shared-secret
# option, so only the backend ever needs a private key; every agent verifies
# via JWKS_URL (default: the backend's own endpoint, see below) or a static
# public key. Generate a keypair with the tool that ships in
# prometheus_api (already installed in every agent container):
#   prometheus-identity-keygen --out-dir ./keys
# or with openssl:
#   openssl genrsa -out identity_private.pem 4096
#   openssl rsa -in identity_private.pem -pubout -out identity_public.pem
# See docs/dev-docs/multi-user-setup.md and
# prometheus_api/docs/agent/IDENTITY_KEY_MANAGEMENT.md for the full picture,
# including JWKS distribution for third-party agent providers.

# Backend only -- mints tokens. Never set this on an agent. Only a bootstrap
# fallback once any signing key is generated+activated via the admin UI
# (Admin > Signing Keys) -- Postgres becomes authoritative at that point.
USER_IDENTITY_PRIVATE_KEY=
# Every agent -- verifies tokens. Defaults to the backend's own JWKS endpoint
# (docker-compose.yml's JWKS_URL default: http://backend:8000/.well-known/jwks.json),
# reachable by every agent on this network by container name -- this is what
# lets an admin-generated/rotated signing key verify with no env var change on
# any agent. Set USER_IDENTITY_PUBLIC_KEY instead only if an agent can't reach
# that URL (e.g. a third-party agent outside this docker network -- give it
# this platform's public JWKS URL instead, or a static public key).
USER_IDENTITY_PUBLIC_KEY=
USER_IDENTITY_ISS=prometheus-platform
USER_IDENTITY_AUD=prometheus-agents
# Minted-token lifetime in seconds; backend only.
USER_IDENTITY_TTL=7200
# false only for local dev/smoke tests without USER_IDENTITY_PRIVATE_KEY configured.
USER_IDENTITY_REQUIRED=true

# --- Multi-user credential plane ---
# "env" (default) preserves today's global DEEPLYNX_*/SLURM_* credential behavior.
# "vault" activates per-user Vault policies (see docs/dev-docs/multi-user-setup.md).
CREDENTIAL_BROKER=env

OAUTH_OKTA_CLIENT_ID=""
OAUTH_OKTA_CLIENT_SECRET=""
OAUTH_OKTA_DOMAIN="identity-preview.inl.gov"
OAUTH_OKTA_AUTHORIZATION_SERVER_ID=false
CHAINLIT_URL=""
